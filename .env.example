# Copie este arquivo para ".env" e preencha os valores.

# Chave da API do Google AI Studio: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=coloque_sua_chave_aqui

# Modelo Gemini (opcional). Ex.: gemini-3.8-flash (padrão), gemini-3.6-flash
GEMINI_MODEL=gemini-3.8-flash

# ----- Voz -----------------------------------------------------------------
# Backend: "edge" = voz neural masculina (padrão, precisa de internet)
#          "sapi" = voz nativa do Windows (offline)
JARVIS_TTS=edge

# Voz neural (edge-tts). Masculinas em PT-BR: pt-BR-AntonioNeural (padrão)
JARVIS_EDGE_VOICE=pt-BR-AntonioNeural
JARVIS_EDGE_RATE=-5%      # velocidade (negativo = mais pausado)
JARVIS_EDGE_PITCH=-8Hz    # tom (negativo = mais grave)

# Opções gerais
# JARVIS_VOZ=0            -> inicia com a voz desligada

# Opções do backend "sapi" (voz do Windows)
# JARVIS_RATE=165         -> velocidade da fala
# JARVIS_VOICE_ID=Daniel  -> trecho do nome/id da voz do Windows a usar

# ----- Entrada por voz (microfone) -----------------------------------------
# JARVIS_MIC_LIMIAR=0      -> sensibilidade; 0 = calibra sozinho (aumente se
#                             disparar com ruído, ex.: 500/800)
# JARVIS_MIC_SILENCIO=1.1  -> segundos de silêncio para encerrar a fala
# JARVIS_MIC_MAX=20        -> duração máxima de uma fala (s)
# JARVIS_MIC_ESPERA=8      -> tempo aguardando você começar a falar (s)

# ---------------------------------------------------------------------------
# Ponte J.A.R.V.I.S. — configuração do daemon do PC.
# Copie este arquivo para .env (NÃO versionado) e preencha.
# ---------------------------------------------------------------------------

# --- Broker MQTT (flespi — veja o README) ---
# No flespi a autenticação é por TOKEN: cole o token no MQTT_USER e deixe a senha
# em branco. (Se der erro de credencial, tente prefixar: FlespiToken <token>.)
MQTT_HOST=mqtt.flespi.io
MQTT_PORT=8883
MQTT_USER=cole-seu-token-flespi-aqui
MQTT_PASS=
MQTT_TLS=true

# Prefixo dos tópicos. Use um sufixo secreto/aleatório para ninguém adivinhar.
# A MESMA string tem que estar no app Android (BuildConfig).
# Tópicos usados: <prefixo>/requests, <prefixo>/confirm, <prefixo>/replies
TOPIC_PREFIX=jarvis/a1b2c3d4

# --- Onde o Claude pode trabalhar ---
# Raiz do workspace. O Claude roda travado aqui dentro (--add-dir).
# O celular manda o nome do projeto; a pasta é <WORKSPACE_ROOT>/<nome>.
WORKSPACE_ROOT=X:\spring-workspace
# Projeto padrão quando o pedido não nomear nenhum (opcional).
DEFAULT_PROJECT=

# --- Claude Code headless ---
# Caminho do executável. "claude" basta se estiver no PATH; senão, o caminho completo.
CLAUDE_BIN=claude
# Tempos máximos (segundos) para a passada de plano e a de execução.
CLAUDE_PLAN_TIMEOUT=180
CLAUDE_EXEC_TIMEOUT=900
# Permissão na hora de EXECUTAR (após seu "sim"):
#   acceptEdits       -> aceita edições de arquivo sozinho; NÃO roda shell sem pedir (seguro, padrão)
#   bypassPermissions -> libera tudo (build/testes/shell) SEM pedir — autonomia total, mais arriscado
CLAUDE_EXEC_PERMISSION_MODE=acceptEdits
